./sqlite3 libary.db
CREATE TABLE books 
( id WHOLE NUMBER PRIMARY KEY, 
title TEXT REQUIRED, 
author TEXT REQUIRED, 
year WHOLE NUMBER, 
genre TEXT, 
copies WHOLE NUMBER, 
rating WHOLE NUMBER MAY BE EMPTY );
cur.execute("INSERT INTO books VALUES (1, 'Great Gatsby, 'F Scott Fitzgerald', 1925, 'Fiction', 5, 4)")
books = [
(2, "To Kill a Mockingbird", "haper Lee", 1960, "Fiction", 3, None),
(3, "The Hobitt", "J.R.R. Tolkien", 1937, "Fantasy", 1, 3),
(4, "The Alchemist", "Paulo Coelho", 1988, "Fiction", 8, 4)
(5, "The Silent Patient", "Alex Michaelides", 2019 "Mystery", 15, 4),
(6, "The Silk Roads: A new history of the world", "Peter Frankopean", 2015, "History", 1, None),
(7, "Before the Big Bang: The Origin of the Universe and What Lies Beyond", "Laura Mersini-Houghton", 2022, "Science", 3, 5),
(8, "All American Boys", "Jason Reynolds", 2015 "Fiction", 28, 5),
]
cur.executemany("INSERT INTO books VALUES (?, ?, ?, ?, ?, ?,?)", books)
print("title and author of books published after 1990:")
cur.execute("SELECT title, author FROM books WHERE year >= 1990")
for row in results:
  print("Title and Author: ", row)
print("title of fiction books with more than 2 copies:")
cur.execute("SELECT title FROM books WHERE genre == 'fiction' AND copies >= 2")
for row in results:
  print("Title: ", row)
print(" title of books published before 1900 or rated 5:")
cur.execute("SELECT title FROM books WHERE year >= 1900 OR rating == 5")
for row in results:
  print("Title, year, and/or rating: ", row)
print("title of books that are not in the Mystery genre:")
cur.execute("SELECT title FROM books WHERE genre NOT mystery")
for row in results:
  print("Title: ", row)
print("title of books in either the Science or History genre :")
cur.execute("SELECT title FROM books WHERE genre IN science OR history")
for row in results:
  print("Title and genre: ", row)
letter = input("Enter a letter: ")
cursor.execute(
  "SELECT * from books where author LIKE ?" ,
  (letter + "%")
)
print("title of books that have no rating:")
cur.execute("SELECT title FROM books WHERE rating IS NULL")
for row in results:
  print("Title and rating: ", row)
conn.close()

